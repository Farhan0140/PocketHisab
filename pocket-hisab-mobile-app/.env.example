# ============================================================================
# PocketHisab mobile app — environment variables.
# Copy to `.env` and fill in. Expo inlines any EXPO_PUBLIC_* variable into
# the JS bundle at build time (see https://docs.expo.dev/guides/environment-variables/)
# — these are NOT secret once the app is built, same as the client-side
# Firebase config they mostly mirror.
# ============================================================================

# --- Backend API -----------------------------------------------------------
# Must be reachable from wherever you're running the app:
#   - Expo web / iOS simulator on the SAME machine as the backend: http://localhost:3000/api/v1
#   - Android emulator (backend on host machine):                  http://10.0.2.2:3000/api/v1
#   - Physical device via Expo Go (same Wi-Fi as the backend):      http://<your-machine-LAN-IP>:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# --- Firebase client config (from firebaseConfig in the Firebase console) --
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
