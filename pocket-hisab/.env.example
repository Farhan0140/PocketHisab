# ============================================================================
# PocketHisab backend — environment variable reference.
# Copy this file to `.env` and fill in real values. `.env` itself is
# git-ignored, so it is safe to put real secrets there but NEVER in this file.
# ============================================================================

# --- Server ---------------------------------------------------------------
PORT=3000
# development | production | test
NODE_ENV=development
# Comma-separated list of allowed origins for CORS in production,
# e.g. https://app.pockethisab.com,https://admin.pockethisab.com
# Use * only for local development.
CORS_ORIGIN=*

# --- Database (Neon Postgres) ----------------------------------------------
# Full Postgres connection string, including sslmode=require (Neon mandates
# SSL for every connection, including the pooled "-pooler" endpoint).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# --- Firebase Admin SDK (server-side auth verification) -------------------
# These come from a SERVICE ACCOUNT, not the client-side firebaseConfig used
# in the mobile app. Generate one at:
#   Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# That downloads a JSON file containing project_id, client_email and
# private_key — copy those three values into the variables below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal "\n" escape sequences in place of real
# newlines (this is how the value survives being stored in a single env var),
# e.g. "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
